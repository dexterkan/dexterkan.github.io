    {
      "name": "Expansion",
      "text": "Evaluate the policy and state value networks at a nonterminal leaf. Add all possible PAM actions as children and initialize their prior probabilities from the policy output. The state value predicts the final negative detection metric, replacing a random rollout.",
      "source": "Section IV-D \u00b7 Figure 4"
    },
    {
      "name": "Backpropagation",
      "text": "Propagate the predicted value upward, average node values, and increment visit counts. At a terminal leaf, use the actual negative detection metric. After the playout budget, choose the root child with the largest visit count; retain its subtree for the next symbol decision.",
      "source": "Section IV-D \u00b7 Figure 4"
    }
  ]
